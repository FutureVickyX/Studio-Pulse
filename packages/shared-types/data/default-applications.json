    {
      "id": "framer",
      "displayName": "Framer",
      "category": "design",
      "enabledByDefault": true,
      "matchers": [{ "exe": "Framer.exe" }]
    },
    {
      "id": "vscode",
      "displayName": "Visual Studio Code",
      "category": "code",
      "enabledByDefault": false,
      "matchers": [
        { "exe": "Code.exe", "pathIncludes": "Microsoft VS Code" },
        { "exe": "Code - Insiders.exe" }
      ]
    }
  ]
}
