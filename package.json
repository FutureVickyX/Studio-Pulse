{
  "name": "studio-pulse",
  "version": "0.1.0",
  "private": true,
  "description": "Studio Pulse — a lightweight task manager, notepad and automatic creative-app time tracker for creative teams.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/desktop",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run tauri:dev -w @studio-pulse/desktop",
    "build": "npm run tauri:build -w @studio-pulse/desktop",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test:ts && npm run test:rust",
    "test:ts": "vitest run",
    "test:ts:watch": "vitest",
    "test:rust": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "test:windows-live": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml --test windows_live -- --ignored --test-threads=1",
    "probe": "cargo run --manifest-path apps/desktop/src-tauri/Cargo.toml --example probe",
    "lint:rust": "cargo clippy --manifest-path apps/desktop/src-tauri/Cargo.toml --all-targets -- -D warnings",
    "fmt:rust": "cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  }
}
