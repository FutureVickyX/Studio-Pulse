{
  "description": "System sleep: after the sample at 4:59 the machine sleeps; the next sample comes 10 minutes later on the wall clock but only 1 s later on the monotonic clock. The interval ends at the last pre-sleep sample (time gap) and the sleep is never credited.",
  "apps": { "figma": "Figma" },
  "steps": [
    { "from": 0, "to": 300000, "app": "figma" },
    { "from": 900000, "to": 1200000, "app": "figma", "monoOffset": -600000, "activity": "tracking", "note": "resume: wall +601 s, monotonic +1 s" },
    { "at": 1200000, "app": null }
  ],
  "expect": {
    "closed": [
      { "id": "iv-1", "app": "figma", "kind": "active", "start": 0, "end": 299000, "reason": "timeGap" },
      { "id": "iv-2", "app": "figma", "kind": "active", "start": 900000, "end": 1200000, "reason": "untracked" }
    ],
    "open": null,
    "totals": { "foregroundMs": 599000, "activeMs": 599000, "idleMs": 0 },
    "discarded": 0
  }
}
