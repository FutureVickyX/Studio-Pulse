{
  "description": "The wall clock jumps one hour ahead between two samples while the monotonic clock advances 1 s. The wall delta exceeds maxGap, so the open interval ends at the previous sample (time gap) and the jump is not credited.",
  "apps": { "figma": "Figma" },
  "steps": [
    { "from": 0, "to": 300000, "app": "figma" },
    { "from": 3900000, "to": 4200000, "app": "figma", "monoOffset": -3600000, "activity": "tracking", "note": "wall +3601 s, monotonic +1 s" },
    { "at": 4200000, "app": null }
  ],
  "expect": {
    "closed": [
      { "id": "iv-1", "app": "figma", "kind": "active", "start": 0, "end": 299000, "reason": "timeGap" },
      { "id": "iv-2", "app": "figma", "kind": "active", "start": 3900000, "end": 4200000, "reason": "untracked" }
    ],
    "open": null,
    "totals": { "foregroundMs": 599000, "activeMs": 599000, "idleMs": 0 },
    "discarded": 0
  }
}
