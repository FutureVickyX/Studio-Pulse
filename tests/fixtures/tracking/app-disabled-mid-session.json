{
  "description": "The user disables Figma in the application registry at 10:00 while it is in the foreground: the same process now matches nothing (the sample's app becomes null), so the interval closes as untracked. Re-enabling it at 15:00 opens a new interval, still open at the end.",
  "apps": { "figma": "Figma" },
  "steps": [
    { "from": 0, "to": 600000, "app": "figma" },
    { "from": 600000, "to": 900000, "app": null, "activity": "untracked", "note": "Figma disabled in the registry" },
    { "from": 900000, "to": 960000, "app": "figma", "activity": "tracking", "note": "Figma re-enabled" }
  ],
  "expect": {
    "closed": [
      { "id": "iv-1", "app": "figma", "kind": "active", "start": 0, "end": 600000, "reason": "untracked" }
    ],
    "open": { "id": "iv-2", "app": "figma", "kind": "active", "start": 900000, "end": 959000 },
    "totals": { "foregroundMs": 659000, "activeMs": 659000, "idleMs": 0 },
    "activity": "tracking",
    "discarded": 0
  }
}
