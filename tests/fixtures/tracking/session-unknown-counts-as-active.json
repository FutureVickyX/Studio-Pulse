{
  "description": "The session-state query fails (unknown) for a while. Unknown is treated as an active session: the foreground and idle checks still apply, and the interval continues across the unknown stretch.",
  "apps": { "figma": "Figma" },
  "steps": [
    { "from": 0, "to": 120000, "app": "figma" },
    { "from": 120000, "to": 240000, "app": "figma", "session": "unknown", "activity": "tracking" },
    { "from": 240000, "to": 300000, "app": "figma" },
    { "at": 300000, "app": "figma", "session": "screenSaver", "activity": "away" }
  ],
  "expect": {
    "closed": [
      { "id": "iv-1", "app": "figma", "kind": "active", "start": 0, "end": 300000, "reason": "sessionAway" }
    ],
    "open": null,
    "totals": { "foregroundMs": 300000, "activeMs": 300000, "idleMs": 0 },
    "discarded": 0
  }
}
