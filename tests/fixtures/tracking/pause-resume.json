{
  "description": "The user pauses tracking at 10:00 and resumes at 15:00. Pausing closes the interval at the last sample; samples while paused are ignored; the first sample after resume starts a fresh interval, so the paused span is never credited.",
  "apps": { "figma": "Figma" },
  "steps": [
    { "from": 0, "to": 600000, "app": "figma" },
    { "op": "pause", "activity": "paused" },
    { "from": 600000, "to": 900000, "app": "figma", "activity": "paused" },
    { "op": "resume", "activity": "starting" },
    { "from": 900000, "to": 1200000, "app": "figma", "activity": "tracking" },
    { "at": 1200000, "app": null }
  ],
  "expect": {
    "closed": [
      { "id": "iv-1", "app": "figma", "kind": "active", "start": 0, "end": 599000, "reason": "paused" },
      { "id": "iv-2", "app": "figma", "kind": "active", "start": 900000, "end": 1200000, "reason": "untracked" }
    ],
    "open": null,
    "totals": { "foregroundMs": 899000, "activeMs": 899000, "idleMs": 0 },
    "discarded": 0
  }
}
