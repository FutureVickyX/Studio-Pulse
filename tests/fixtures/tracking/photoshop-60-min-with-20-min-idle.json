{
  "description": "The architecture example (section 4.1): Photoshop in the foreground for 60 minutes with no input from 20:00 to 40:00. With the 5-minute threshold the idle stretch is detected at 25:00 and truncated back to the last input, so reports show foreground 60 m, active 40 m, idle 20 m.",
  "apps": { "photoshop": "Adobe Photoshop" },
  "config": { "idleThresholdMs": 300000 },
  "steps": [
    { "from": 0, "to": 1200000, "app": "photoshop", "activity": "tracking" },
    { "from": 1200000, "to": 1500000, "app": "photoshop", "lastInputAt": 1200000, "activity": "tracking", "note": "no input since 20:00, below the threshold" },
    { "from": 1500000, "to": 2400000, "app": "photoshop", "lastInputAt": 1200000, "activity": "idle", "note": "25:00: idle detected, active truncated back to 20:00" },
    { "from": 2400000, "to": 3600000, "app": "photoshop", "activity": "tracking", "note": "input resumes at 40:00" },
    { "at": 3600000, "app": null }
  ],
  "expect": {
    "closed": [
      { "id": "iv-1", "app": "photoshop", "kind": "active", "start": 0, "end": 1200000, "reason": "becameIdle" },
      { "id": "iv-2", "app": "photoshop", "kind": "idle", "start": 1200000, "end": 2400000, "reason": "inputResumed" },
      { "id": "iv-3", "app": "photoshop", "kind": "active", "start": 2400000, "end": 3600000, "reason": "untracked" }
    ],
    "open": null,
    "totals": { "foregroundMs": 3600000, "activeMs": 2400000, "idleMs": 1200000 },
    "discarded": 0
  }
}
