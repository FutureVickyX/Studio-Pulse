{
  "description": "The idle threshold is lowered from 5 to 2 minutes while the user has been inactive for 3 minutes. The open interval closes at the last sample (settingsChanged) under the old classification; the next sample starts fresh and is classified with the new threshold (idle from that sample on, never retroactively). Input at 15:00 ends the idle interval.",
  "apps": { "figma": "Figma" },
  "steps": [
    { "from": 0, "to": 600000, "app": "figma" },
    { "from": 600000, "to": 780000, "app": "figma", "lastInputAt": 600000, "activity": "tracking", "note": "3 min without input: below the 5 min threshold" },
    { "op": "setConfig", "config": { "idleThresholdMs": 120000 }, "activity": "starting" },
    { "from": 780000, "to": 900000, "app": "figma", "lastInputAt": 600000, "activity": "idle" },
    { "from": 900000, "to": 1000000, "app": "figma", "activity": "tracking" },
    { "at": 1000000, "app": null }
  ],
  "expect": {
    "closed": [
      { "id": "iv-1", "app": "figma", "kind": "active", "start": 0, "end": 779000, "reason": "settingsChanged" },
      { "id": "iv-2", "app": "figma", "kind": "idle", "start": 780000, "end": 900000, "reason": "inputResumed" },
      { "id": "iv-3", "app": "figma", "kind": "active", "start": 900000, "end": 1000000, "reason": "untracked" }
    ],
    "open": null,
    "totals": { "foregroundMs": 999000, "activeMs": 879000, "idleMs": 120000 },
    "discarded": 0
  }
}
