{
  "description": "Tracking is disabled in settings at 10:00 (the service calls pause(disabled)) and re-enabled at 20:00. The interval closes with reason disabled, nothing is recorded while disabled, and the run ends with an open interval after re-enabling.",
  "apps": { "photoshop": "Adobe Photoshop" },
  "steps": [
    { "from": 0, "to": 600000, "app": "photoshop" },
    { "op": "pause", "reason": "disabled", "activity": "paused" },
    { "from": 600000, "to": 1200000, "app": "photoshop", "activity": "paused" },
    { "op": "resume", "note": "tracking re-enabled" },
    { "from": 1200000, "to": 1500000, "app": "photoshop", "activity": "tracking" }
  ],
  "expect": {
    "closed": [
      { "id": "iv-1", "app": "photoshop", "kind": "active", "start": 0, "end": 599000, "reason": "disabled" }
    ],
    "open": { "id": "iv-2", "app": "photoshop", "kind": "active", "start": 1200000, "end": 1499000 },
    "totals": { "foregroundMs": 898000, "activeMs": 898000, "idleMs": 0 },
    "activity": "tracking",
    "discarded": 0
  }
}
