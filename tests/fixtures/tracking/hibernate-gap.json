  "steps": [
    { "from": 0, "to": 300000, "app": "blender" },
    { "from": 3900000, "to": 4200000, "app": "blender", "activity": "tracking", "note": "both clocks +1 h" },
    { "at": 4200000, "app": null }
  ],
  "expect": {
    "closed": [
      { "id": "iv-1", "app": "blender", "kind": "active", "start": 0, "end": 299000, "reason": "timeGap" },
      { "id": "iv-2", "app": "blender", "kind": "active", "start": 3900000, "end": 4200000, "reason": "untracked" }
    ],
    "open": null,
    "totals": { "foregroundMs": 599000, "activeMs": 599000, "idleMs": 0 },
    "discarded": 0
  }
