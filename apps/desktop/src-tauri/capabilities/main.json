{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Main workspace window: every Studio Pulse command except hide_indicator. Core access is limited to event listen/unlisten; no tray, menu, image, path, shell, fs or http APIs.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-tracker-status",
    "allow-pause-tracking",
    "allow-resume-tracking",
    "allow-list-tracking-events",
    "allow-get-settings",
    "allow-update-settings",
    "allow-complete-onboarding",
    "allow-get-startup-status",
    "allow-set-launch-at-login",
    "allow-list-applications",
    "allow-save-application",
    "allow-delete-application",
    "allow-reset-applications",
    "allow-list-running-applications",
    "allow-pick-executable",
    "allow-get-data-summary",
    "allow-export-tracking-events",
    "allow-delete-tracking-events",
    "allow-get-app-info",
    "allow-show-main-window",
    "allow-quit-app",
    "allow-get-account-status",
    "allow-sign-in",
    "allow-sign-up",
    "allow-sign-out",
    "allow-refresh-workspaces",
    "allow-create-workspace",
    "allow-select-sync-workspace",
    "allow-accept-invitation",
    "allow-create-invitation",
    "allow-get-sync-status",
    "allow-sync-now",
    "allow-claim-local-history"
  ]
}
