# Studio Pulse workspace (apps/web). Copy to apps/web/.env.local (gitignored) and fill in.
# Public values only: the build refuses a secret / service-role key.
#
# Project Settings › API › Project URL
VITE_SUPABASE_URL=
# Project Settings › API › Publishable key (or the legacy anon key)
VITE_SUPABASE_PUBLISHABLE_KEY=
